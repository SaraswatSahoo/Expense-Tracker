// The connection URL lives in prisma.config.ts.
// Add models here, then run `npm run db:migrate`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  refreshTokens        RefreshToken[]
  groupsCreated        Group[]        @relation("GroupCreator")
  memberships          GroupMember[]
  expensesPaid         Expense[]      @relation("ExpensePayer")
  expensesCreated      Expense[]      @relation("ExpenseCreator")
  expenseSplits        ExpenseSplit[]
  settlementsPaid      Settlement[]   @relation("SettlementPayer")
  settlementsToReceive Settlement[]   @relation("SettlementReceiver")
  settlementsCreated   Settlement[]   @relation("SettlementCreator")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  currency    String   @db.Char(3) // ISO 4217, e.g. INR
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  createdBy   User          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]

  @@index([createdById])
}

model GroupMember {
  groupId   String    @db.Uuid
  userId    String    @db.Uuid
  leftAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3) // when they joined
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([groupId, userId])
  @@index([userId])
}

model Expense {
  id          String    @id @default(uuid(7)) @db.Uuid
  groupId     String    @db.Uuid
  paidById    String    @db.Uuid
  createdById String    @db.Uuid
  description String
  amount      Decimal   @db.Decimal(12, 2)
  expenseDate DateTime  @db.Date
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy User           @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  splits    ExpenseSplit[]

  @@index([groupId, expenseDate(sort: Desc)])
  @@index([paidById])
  @@index([createdById])
}

model ExpenseSplit {
  expenseId   String   @db.Uuid
  userId      String   @db.Uuid
  shareAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([expenseId, userId])
  @@index([userId])
}

model Settlement {
  id          String           @id @default(uuid(7)) @db.Uuid
  groupId     String           @db.Uuid
  fromUserId  String           @db.Uuid // who paid the money
  toUserId    String           @db.Uuid // who received it, and who confirms or rejects
  createdById String           @db.Uuid
  amount      Decimal          @db.Decimal(12, 2)
  settledOn   DateTime         @db.Date
  status      SettlementStatus @default(PENDING)
  respondedAt DateTime?        @db.Timestamptz(3) // when it was confirmed or rejected
  note        String?
  deletedAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser  User  @relation("SettlementPayer", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser    User  @relation("SettlementReceiver", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy User  @relation("SettlementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([groupId, settledOn(sort: Desc)])
  @@index([fromUserId])
  @@index([toUserId, status])
  @@index([createdById])
}
